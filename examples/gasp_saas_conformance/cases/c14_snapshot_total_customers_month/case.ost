# The model beside this script. Each of its datasets is a relation in the schema
# gasp_conformance_c14_snapshot_total_customers_month.
modelFile("gasp_conformance_c14_snapshot_total_customers_month", "model.ossie.yaml");

# readings.sql also lists rows_over_every_date, which changes the SQL of the model and so has no
# query here.

# Grade right. gasp_total_customers for the period, read on the last snapshot date of the period as
# the formula says (at period_end).
executeExpand(
  SELECT AGG(gasp_total_customers) AS value
  FROM gasp_conformance_c14_snapshot_total_customers_month.customer
  WHERE snapshot_date = DATE '2026-06-30');
> {_|
SELECT
  COUNT(DISTINCT customer_id) FILTER(WHERE
    customer_status = 'active') AS value
FROM gasp.customer
WHERE
  snapshot_date = CAST('2026-06-30' AS DATE)
|_} : string
+-------+
| value |
+-------+
|    18 |
+-------+

# Grade wrong, reading distinct_over_every_date: the distinct count taken over every snapshot date
# in the period, so a customer active on any day of it is counted, one who left before the last day
# included.
executeExpand(
  SELECT AGG(gasp_total_customers) AS value
  FROM gasp_conformance_c14_snapshot_total_customers_month.customer
  WHERE snapshot_date >= DATE '2026-06-01' AND snapshot_date <= DATE '2026-06-30');
> {_|
SELECT
  COUNT(DISTINCT customer_id) FILTER(WHERE
    customer_status = 'active') AS value
FROM gasp.customer
WHERE
  snapshot_date >= CAST('2026-06-01' AS DATE)
  AND snapshot_date <= CAST('2026-06-30' AS DATE)
|_} : string
+-------+
| value |
+-------+
|    19 |
+-------+

# Grade wrong, reading opening_value: the count on the first snapshot date of the period, where the
# formula reads the last.
executeExpand(
  SELECT AGG(gasp_total_customers) AS value
  FROM gasp_conformance_c14_snapshot_total_customers_month.customer
  WHERE snapshot_date = DATE '2026-06-01');
> {_|
SELECT
  COUNT(DISTINCT customer_id) FILTER(WHERE
    customer_status = 'active') AS value
FROM gasp.customer
WHERE
  snapshot_date = CAST('2026-06-01' AS DATE)
|_} : string
+-------+
| value |
+-------+
|    16 |
+-------+
