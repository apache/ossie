# The model beside this script. Each of its datasets is a relation in the schema
# gasp_conformance_c13_snapshot_mrr_quarter.
modelFile("gasp_conformance_c13_snapshot_mrr_quarter", "model.ossie.yaml");

# Grade right. gasp_mrr for the period, read on the last snapshot date of the period as the formula
# says (at period_end).
executeExpand(
  SELECT AGG(gasp_mrr) AS value
  FROM gasp_conformance_c13_snapshot_mrr_quarter.subscription
  WHERE snapshot_date = DATE '2026-06-30');
> {_|
SELECT
  COALESCE(SUM(mrr) FILTER(WHERE
    subscription_status = 'active'), 0) AS value
FROM gasp.subscription
WHERE
  snapshot_date = CAST('2026-06-30' AS DATE)
|_} : string
+--------------+
| value        |
+--------------+
| 24200.000000 |
+--------------+

# Grade wrong, reading month_ends_summed: the closing value of each month in the period added
# together, where the formula reads the closing value of the last.
executeExpand(
  SELECT AGG(gasp_mrr) AS value
  FROM gasp_conformance_c13_snapshot_mrr_quarter.subscription
  WHERE snapshot_date IN (DATE '2026-04-30', DATE '2026-05-31', DATE '2026-06-30'));
> {_|
SELECT
  COALESCE(SUM(mrr) FILTER(WHERE
    subscription_status = 'active'), 0) AS value
FROM gasp.subscription
WHERE
  snapshot_date IN (
    CAST('2026-04-30' AS DATE),
    CAST('2026-05-31' AS DATE),
    CAST('2026-06-30' AS DATE)
  )
|_} : string
+--------------+
| value        |
+--------------+
| 64800.000000 |
+--------------+

# Grade wrong, reading opening_value: the sum on the first snapshot date of the period, where the
# formula reads the last.
executeExpand(
  SELECT AGG(gasp_mrr) AS value
  FROM gasp_conformance_c13_snapshot_mrr_quarter.subscription
  WHERE snapshot_date = DATE '2026-04-01');
> {_|
SELECT
  COALESCE(SUM(mrr) FILTER(WHERE
    subscription_status = 'active'), 0) AS value
FROM gasp.subscription
WHERE
  snapshot_date = CAST('2026-04-01' AS DATE)
|_} : string
+--------------+
| value        |
+--------------+
| 18400.000000 |
+--------------+
