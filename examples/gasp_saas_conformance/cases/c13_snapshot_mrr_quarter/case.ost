# GASP conformance case c13_snapshot_mrr_quarter: a sum over a snapshot dataset for a quarter, read
# on the last snapshot date of the quarter.
# Metric gasp_mrr for the period 2026-04-01 to 2026-06-30. GASP formula:
#   sum(field.mrr where field.subscription_status = 'active') at period_end
# https://gaspwiki.com/v1/metrics/core/mrr-monthly-recurring-revenue
#
# A script for ost, the Apache Ossie SQL test runner (ost/docs/ost.md in apache/ossie).
# executeExpand expands the query with the view expander into SQL over the tables created below and
# runs it on DuckDB. The text and the table under each command are the expected output, as ost wrote
# them. Run it from the conformance directory:
#   uv run --project <apache/ossie checkout>/ost ost -d . cases/c13_snapshot_mrr_quarter/case.ost
#
# Generated by npm run conformance in gasp-wiki-mcp. Do not edit.

# A double is written with 6 digits after the point.
set("doubleDigits", 6);

# The tables the case reads: the statements of ../../data/period_spine.sql and
# ../../data/subscription.sql, copied here so the script stands alone.
# The reporting periods the staged sources compute for: one row per period. A case reads the row for its own period.
CREATE SCHEMA gasp;
CREATE TABLE gasp.period_spine (period_start DATE, period_end DATE);
INSERT INTO gasp.period_spine (period_start, period_end) VALUES (DATE '2026-01-01', DATE '2026-06-30'), (DATE '2026-02-09', DATE '2026-03-08');
# GASP dataset subscription (snapshot; Subscription). snapshot rows on month starts, month ends and the period bounds shifted back by one, three, six and twelve months; on every date from 2026-06-01 to 2026-06-30, which a listed reading sums across
# Generated from the GASP test fixture (gasp-wiki-mcp/test/fixture/generate.ts, seed 20260101) by npm run conformance.
