# The model beside this script. Each of its datasets is a relation in the schema
# gasp_conformance_c05_period_bound_in_filter_win_rate.
modelFile("gasp_conformance_c05_period_bound_in_filter_win_rate", "model.ossie.yaml");

# readings.sql also lists period_on_snapshot_date_only, which changes the SQL of the model and so
# has no query here.

# Grade right. gasp_win_rate for the period: the row of the staged dataset for the period.
executeExpand(
  SELECT AGG(gasp_win_rate) AS value
  FROM gasp_conformance_c05_period_bound_in_filter_win_rate.gasp_staged_gasp_win_rate
  WHERE period_start = DATE '2026-01-01' AND period_end = DATE '2026-06-30');
> {_|
SELECT
  SUM(value) AS value
FROM (
  SELECT
    p.period_start,
    p.period_end,
    (
      (
        CAST((
          SELECT
            COUNT(opportunity_id)
          FROM gasp.opportunity
          WHERE
            snapshot_date = p.period_end
            AND (
              opportunity_stage = 'closed_won'
              AND (
                close_date >= p.period_start AND close_date <= p.period_end
              )
            )
        ) AS DOUBLE) / NULLIF(
          (
            SELECT
              COUNT(opportunity_id)
            FROM gasp.opportunity
            WHERE
              snapshot_date = p.period_end
              AND (
                opportunity_stage IN ('closed_won', 'closed_lost')
                AND (
                  close_date >= p.period_start AND close_date <= p.period_end
                )
              )
          ),
          0
        )
      )
    ) AS value
  FROM gasp.period_spine AS p
) AS gasp_staged_gasp_win_rate
WHERE
  period_start = CAST('2026-01-01' AS DATE)
  AND period_end = CAST('2026-06-30' AS DATE)
|_} : string
+----------+
| value    |
+----------+
| 0.500000 |
+----------+
