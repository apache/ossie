# GASP conformance case c05_period_bound_in_filter_win_rate: the reporting period bound to a field
# other than the dataset's time field (opportunities by close date on a snapshot).
# Metric gasp_win_rate for the period 2026-01-01 to 2026-06-30. GASP formula:
#   count(field.opportunity_id where field.opportunity_stage = 'closed_won' and in_period(field.close_date)) / count(field.opportunity_id where field.opportunity_stage in ('closed_won', 'closed_lost') and in_period(field.close_date))
# https://gaspwiki.com/v1/metrics/sales/win-rate
#
# A script for ost, the Apache Ossie SQL test runner (ost/docs/ost.md in apache/ossie).
# executeExpand expands the query with the view expander into SQL over the tables created below and
# runs it on DuckDB. The text and the table under each command are the expected output, as ost wrote
# them. Run it from the conformance directory:
#   uv run --project <apache/ossie checkout>/ost ost -d . cases/c05_period_bound_in_filter_win_rate/case.ost
#
# Generated by npm run conformance in gasp-wiki-mcp. Do not edit.

# A double is written with 6 digits after the point.
set("doubleDigits", 6);

# The tables the case reads: the statements of ../../data/period_spine.sql and
# ../../data/opportunity.sql, copied here so the script stands alone.
# The reporting periods the staged sources compute for: one row per period. A case reads the row for its own period.
CREATE SCHEMA gasp;
CREATE TABLE gasp.period_spine (period_start DATE, period_end DATE);
INSERT INTO gasp.period_spine (period_start, period_end) VALUES (DATE '2026-01-01', DATE '2026-06-30'), (DATE '2026-02-09', DATE '2026-03-08');
# GASP dataset opportunity (snapshot; Opportunity). snapshot rows on month starts, month ends and the period bounds shifted back by one, three, six and twelve months
# Generated from the GASP test fixture (gasp-wiki-mcp/test/fixture/generate.ts, seed 20260101) by npm run conformance.
CREATE TABLE gasp.opportunity (
  advanced_to_next_stage BOOLEAN,
  channel VARCHAR(1000),
  close_date DATE,
  close_date_valid BOOLEAN,
  customer_id VARCHAR(1000),
  forecast_category VARCHAR(1000),
  includes_services BOOLEAN,
  lead_id VARCHAR(1000),
  marketing_influenced BOOLEAN,
  marketing_source VARCHAR(1000),
  opportunity_amount DECIMAL(18, 6),
  opportunity_created_date DATE,
  opportunity_id VARCHAR(1000),
  opportunity_stage VARCHAR(1000),
  partner_id VARCHAR(1000),
  partner_sourced BOOLEAN,
  rep_id VARCHAR(1000),
  required_fields_complete BOOLEAN,
  revenue_type VARCHAR(1000),
  snapshot_date DATE,
  stage_accurate BOOLEAN,
  stage_probability DECIMAL(18, 6),
  updated_within_sla BOOLEAN,
  partner_type VARCHAR(1000)
);
