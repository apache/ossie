# GASP conformance case c01_cohort_nrr: a cohort fixed at the opening of the period and followed
# through its events (Net Revenue Retention).
# Metric gasp_nrr for the period 2026-01-01 to 2026-06-30. GASP formula:
#   (metric.mrr at period_start + metric.expansion_mrr - metric.contraction_mrr - metric.churned_mrr) / metric.mrr at period_start over cohort(field.customer_id, period_start)
# https://gaspwiki.com/v1/metrics/core/net-revenue-retention-nrr
#
# A script for ost, the Apache Ossie SQL test runner (ost/docs/ost.md in apache/ossie).
# executeExpand expands the query with the view expander into SQL over the tables created below and
# runs it on DuckDB. The text and the table under each command are the expected output, as ost wrote
# them. Run it from the conformance directory:
#   uv run --project <apache/ossie checkout>/ost ost -d . cases/c01_cohort_nrr/case.ost
#
# Generated by npm run conformance in gasp-wiki-mcp. Do not edit.

# A double is written with 6 digits after the point.
set("doubleDigits", 6);

# The tables the case reads: the statements of ../../data/period_spine.sql and
# ../../data/revenue_event.sql and ../../data/customer.sql and ../../data/subscription.sql, copied
# here so the script stands alone.
# The reporting periods the staged sources compute for: one row per period. A case reads the row for its own period.
CREATE SCHEMA gasp;
CREATE TABLE gasp.period_spine (period_start DATE, period_end DATE);
INSERT INTO gasp.period_spine (period_start, period_end) VALUES (DATE '2026-01-01', DATE '2026-06-30'), (DATE '2026-02-09', DATE '2026-03-08');
# GASP dataset revenue_event (event; Revenue event). rows dated from 2025-12-01
# Generated from the GASP test fixture (gasp-wiki-mcp/test/fixture/generate.ts, seed 20260101) by npm run conformance.
CREATE TABLE gasp.revenue_event (
  change_nature VARCHAR(1000),
  currency VARCHAR(1000),
  customer_id VARCHAR(1000),
  event_date DATE,
  event_id VARCHAR(1000),
  event_type VARCHAR(1000),
  expansion_classification VARCHAR(1000),
  lifecycle_attribution VARCHAR(1000),
  mrr_change DECIMAL(18, 6),
  new_mrr DECIMAL(18, 6),
  prior_mrr DECIMAL(18, 6),
  segment VARCHAR(1000),
  subscription_id VARCHAR(1000)
);
