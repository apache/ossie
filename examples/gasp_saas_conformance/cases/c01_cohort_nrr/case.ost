# The model beside this script. Each of its datasets is a relation in the schema
# gasp_conformance_c01_cohort_nrr.
modelFile("gasp_conformance_c01_cohort_nrr", "model.ossie.yaml");

# Grade right. gasp_nrr for the period: the rows of the staged dataset for the period, which the
# metric's expression sums.
executeExpand(
  SELECT AGG(gasp_nrr) AS value
  FROM gasp_conformance_c01_cohort_nrr.gasp_account_cohorts
  WHERE period_start = DATE '2026-01-01' AND period_end = DATE '2026-06-30');
> {_|
SELECT
  (
    CAST((
      (
        (
          SUM(opening_mrr) + SUM(expansion_mrr)
        ) - SUM(contraction_mrr)
      ) - SUM(churned_mrr)
    ) AS DECIMAL(18, 3)) / NULLIF(SUM(opening_mrr), 0)
  ) AS value
FROM (
  SELECT
    p.period_start,
    p.period_end,
    _c.customer_id,
    (
      SELECT
        COALESCE(SUM(mrr), 0)
      FROM gasp.subscription
      WHERE
        snapshot_date = p.period_start
        AND subscription_status = 'active'
        AND customer_id = _c.customer_id
    ) AS opening_mrr,
    (
      SELECT
        COALESCE(SUM(mrr_change), 0)
      FROM gasp.revenue_event
      WHERE
        event_date >= p.period_start
        AND event_date <= p.period_end
        AND event_type = 'expansion'
        AND customer_id = _c.customer_id
    ) AS expansion_mrr,
    (
      -(
        SELECT
          COALESCE(SUM(mrr_change), 0)
        FROM gasp.revenue_event
        WHERE
          event_date >= p.period_start
          AND event_date <= p.period_end
          AND event_type = 'contraction'
          AND customer_id = _c.customer_id
      )
    ) AS contraction_mrr,
    (
      -(
        SELECT
          COALESCE(SUM(mrr_change), 0)
        FROM gasp.revenue_event
        WHERE
          event_date >= p.period_start
          AND event_date <= p.period_end
          AND event_type = 'churn'
          AND customer_id = _c.customer_id
      )
    ) AS churned_mrr
  FROM gasp.period_spine AS p
  JOIN (
    SELECT
      customer_id AS customer_id,
      snapshot_date AS _day
    FROM gasp.customer
    WHERE
      customer_status = 'active'
  ) AS _c
    ON _c._day = p.period_start
) AS gasp_account_cohorts
WHERE
  period_start = CAST('2026-01-01' AS DATE)
  AND period_end = CAST('2026-06-30' AS DATE)
|_} : string
