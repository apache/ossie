# ============================================================================
# Compliance queries B11, B11a
#
# A test case for core-spec/relational_semantics.md over the classic SCOTT
# schema, as an ost script (apache/ossie#501). The argument to
# executeExpand is the query under test. executeExpand expands it with
# the view expander (apache/ossie#502) into an equivalent DuckDB query
# over the datasets' source tables, and executes the expansion. The
# table that follows is the expected result. README.md gives the rules
# for cases.
#
# Case B11a uses the dataset pet.
#
# Part B: joins. A join can repeat a row of a measure's source (fan-out).
# An outer join can also add NULL-padded rows that come from no source row.
# AGG(m) aggregates each source row of m once and ignores NULL-padded rows
# (spec Section 8.1). The comments give the result of a plain aggregate over
# the joined rows ("naive") where it differs.
#
# The expansion follows the reference evaluation strategy of spec
# Section 9, as README.md describes.
#
# Run, from the root of the repository:
#   uv run --project ost ost -d compliance compliance/query/b11_right_join_keeps_non_managers.ost
#
# Expected-result format:
#   * NULL is shown as an empty cell.
#   * DOUBLE values are rounded to 2 decimal places.
#
# References:
#   * Spec: core-spec/relational_semantics.md (apache/ossie#354)
#   * Dataset-scoped metrics: apache/ossie#591
#   * Test format: apache/ossie#501. View expander: apache/ossie#502.
# ============================================================================

# The "scott" fixture has tables dept, emp, bonus, salgrade and pet in
# schema scott, with the same values as scott/scott.sql.
connect("scott");
set("doubleDigits", 2);

# The model is scott/scott_model.ossie.yaml; its comments describe it. Each
# dataset is a relation in schema scott_model, such as scott_model.emp.
modelFile("scott_model", "scott/scott_model.ossie.yaml");

# ----------------------------------------------------------------------------
# B9-B13. One self-join query with each join type.
#
# e is the employee and m is the manager, joined on e.mgr = m.empno. Both
# sides have rows that do not match:
#   * KING has no manager, so KING has no match on the e side.
#   * 8 employees manage nobody, so they have no match on the m side.
# The join type decides which source rows reach each measure. The join never
# inflates a measure, and NULL-padded rows add nothing:
#
#   join type   joined rows   e_count  e_sal     m_count  m_sal
#   INNER       13            13       24025.00  6        19275.00
#   LEFT        14            14       29025.00  6        19275.00
#   RIGHT       21            13       24025.00  14       29025.00
#   FULL        22            14       29025.00  14       29025.00
#   CROSS       196           14       29025.00  14       29025.00
#
# Naive SUM(m.sal) for the INNER join is 43650: KING's salary is counted 3
# times and BLAKE's 5 times.
#
# Cases B9a to B13a run one query that joins emp to pet, on
# p.empno = e.empno, with each join type. Both sides have rows that do not
# match: 9 employees have no pet, and TRAMP has no owner.
#
#   join type   joined rows   e_count  e_sal     p_count  p_age
#   INNER         7            5       11675.00  7        30
#   LEFT         16           14       29025.00  7        30
#   RIGHT         8            5       11675.00  8        34
#   FULL         17           14       29025.00  8        34
#   CROSS       112           14       29025.00  8        34
#
# Naive SUM(e.sal) for the INNER join is 17625: JONES's salary is counted 3
# times.
# Spec: 7.6, 8.1, G2 (8.3), A.6
# ----------------------------------------------------------------------------

# ----------------------------------------------------------------------------
# B11. RIGHT JOIN: the employees that manage nobody stay on the m side.
# Question: Over all employees as managers and the employees that report to
#   them, how many employees are on each side, and what do they earn?
# B9 to B13 run one self-join query with each join type. e is the employee
# and m is the manager, joined on e.mgr = m.empno. KING has no manager, and 8
# employees manage nobody. The join type decides which rows reach each
# measure. No join type makes a measure count a row twice, and NULL-padded
# rows add nothing.
#
# RIGHT gives 21 joined rows. The 8 employees that manage nobody are kept on
# the m side. Their rows are NULL-padded on the e side, so the e measures are
# the same as for INNER (B9).
# Spec: 7.6, 8.1, G2 (8.3), A.6
# ----------------------------------------------------------------------------
executeExpand(
  SELECT AGG(e.emp_count) AS e_count,
         AGG(e.sum_sal) AS e_sal,
         AGG(m.emp_count) AS m_count,
         AGG(m.sum_sal) AS m_sal
  FROM scott_model.emp AS e
  RIGHT JOIN scott_model.emp AS m ON e.mgr = m.empno);
> {_|
WITH joined AS (
  SELECT
    e.empno AS e_k,
    e.sal AS e_sal,
    m.empno AS m_k,
    m.sal AS m_sal
  FROM scott.emp AS e
  RIGHT JOIN scott.emp AS m
    ON e.mgr = m.empno
)
SELECT
  (
    SELECT
      COUNT(*)
    FROM (
      SELECT
        j.e_k
      FROM joined AS j
      WHERE
        j.e_k IS NOT NULL
      GROUP BY
        j.e_k
    ) AS x
  ) AS e_count,
  (
    SELECT
      SUM(x.sal)
    FROM (
      SELECT
        ANY_VALUE(j.e_sal) AS sal
      FROM joined AS j
      WHERE
        j.e_k IS NOT NULL
      GROUP BY
        j.e_k
    ) AS x
  ) AS e_sal,
  (
    SELECT
      COUNT(*)
    FROM (
      SELECT
        j.m_k
      FROM joined AS j
      WHERE
        j.m_k IS NOT NULL
      GROUP BY
        j.m_k
    ) AS x
  ) AS m_count,
  (
    SELECT
      SUM(x.sal)
    FROM (
      SELECT
        ANY_VALUE(j.m_sal) AS sal
      FROM joined AS j
      WHERE
        j.m_k IS NOT NULL
      GROUP BY
        j.m_k
    ) AS x
  ) AS m_sal
|_} : string
+---------+----------+---------+----------+
| e_count | e_sal    | m_count | m_sal    |
+---------+----------+---------+----------+
|      13 | 24025.00 |      14 | 29025.00 |
+---------+----------+---------+----------+

# ----------------------------------------------------------------------------
# B11a. RIGHT JOIN.
# Only employees that have a pet, and all pets.
# ----------------------------------------------------------------------------
executeExpand(
  SELECT AGG(e.emp_count) AS e_count,
         AGG(e.sum_sal) AS e_sal,
         AGG(p.pet_count) AS p_count,
         AGG(p.sum_age) AS p_age
  FROM scott_model.emp AS e
  RIGHT JOIN scott_model.pet AS p ON p.empno = e.empno);
> {_|
WITH joined AS (
  SELECT
    e.empno AS e_k,
    e.sal AS e_sal,
    p.pname AS p_k,
    p.age AS p_age
  FROM scott.emp AS e
  RIGHT JOIN scott.pet AS p
    ON p.empno = e.empno
)
SELECT
  (
    SELECT
      COUNT(*)
    FROM (
      SELECT
        j.e_k
      FROM joined AS j
      WHERE
        j.e_k IS NOT NULL
      GROUP BY
        j.e_k
    ) AS x
  ) AS e_count,
  (
    SELECT
      SUM(x.sal)
    FROM (
      SELECT
        ANY_VALUE(j.e_sal) AS sal
      FROM joined AS j
      WHERE
        j.e_k IS NOT NULL
      GROUP BY
        j.e_k
    ) AS x
  ) AS e_sal,
  (
    SELECT
      COUNT(*)
    FROM (
      SELECT
        j.p_k
      FROM joined AS j
      WHERE
        j.p_k IS NOT NULL
      GROUP BY
        j.p_k
    ) AS x
  ) AS p_count,
  (
    SELECT
      SUM(x.age)
    FROM (
      SELECT
        ANY_VALUE(j.p_age) AS age
      FROM joined AS j
      WHERE
        j.p_k IS NOT NULL
      GROUP BY
        j.p_k
    ) AS x
  ) AS p_age
|_} : string
+---------+----------+---------+-------+
| e_count | e_sal    | p_count | p_age |
+---------+----------+---------+-------+
|       5 | 11675.00 |       8 |    34 |
+---------+----------+---------+-------+

# End b11_right_join_keeps_non_managers.ost
