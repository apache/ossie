# ============================================================================
# Compliance query B7
#
# A test case for core-spec/relational_semantics.md over the classic SCOTT
# schema, as an ost script (apache/ossie#501). The argument to
# executeExpand is the query under test. executeExpand expands it with
# the view expander (apache/ossie#502) into an equivalent DuckDB query
# over the datasets' source tables, and executes the expansion. The
# table that follows is the expected result. README.md gives the rules
# for cases.
#
# Part B: joins. A join can repeat a row of a measure's source (fan-out).
# An outer join can also add NULL-padded rows that come from no source row.
# AGG(m) aggregates each source row of m once and ignores NULL-padded rows
# (spec Section 8.1). The comments give the result of a plain aggregate over
# the joined rows ("naive") where it differs.
#
# The expansion follows the reference evaluation strategy of spec
# Section 9, as README.md describes.
#
# Run, from the root of the repository:
#   uv run --project ost ost -d compliance compliance/query/b07_three_way_join_fan_out.ost
#
# Expected-result format:
#   * NULL is shown as an empty cell.
#   * DOUBLE values are rounded to 2 decimal places.
#
# References:
#   * Spec: core-spec/relational_semantics.md (apache/ossie#354)
#   * Dataset-scoped metrics: apache/ossie#591
#   * Test format: apache/ossie#501. View expander: apache/ossie#502.
# ============================================================================

# The "scott" fixture has tables dept, emp, bonus, salgrade and pet in
# schema scott, with the same values as scott/scott.sql.
connect("scott");
set("doubleDigits", 2);

# The model is scott/scott_model.ossie.yaml; its comments describe it. Each
# dataset is a relation in schema scott_model, such as scott_model.emp.
modelFile("scott_model", "scott/scott_model.ossie.yaml");

# ----------------------------------------------------------------------------
# B7. Fan-out in a three-way join.
# Question: For each salary grade, how many employees are in it, what is
#   their total salary, and how many departments have one of them?
# emp joins to dept and to salgrade, and the group is the salary grade.
# AGG(d.dept_count) gives the number of departments that have an employee in
# the grade. The join repeats each dept row once for each of its employees in
# the grade. A plain COUNT(*) over the joined rows gives 3, 3, 2, 5, 1.
# Spec: 7.6, G2 (8.3)
# ----------------------------------------------------------------------------
executeExpand(
  SELECT s.grade,
         AGG(e.emp_count) AS emp_count,
         AGG(e.sum_sal) AS sum_sal,
         AGG(d.dept_count) AS dept_count
  FROM scott_model.emp AS e
  JOIN scott_model.dept AS d ON e.deptno = d.deptno
  JOIN scott_model.salgrade AS s ON e.sal BETWEEN s.losal AND s.hisal
  GROUP BY s.grade
  ORDER BY s.grade);
> {_|
WITH joined AS (
  SELECT
    s.grade AS grade,
    e.empno AS e_k,
    e.sal AS e_sal,
    d.deptno AS d_k
  FROM scott.emp AS e
  JOIN scott.dept AS d
    ON e.deptno = d.deptno
  JOIN scott.salgrade AS s
    ON e.sal BETWEEN s.losal AND s.hisal
), spine AS (
  SELECT DISTINCT
    grade
  FROM joined
)
SELECT
  g.grade,
  (
    SELECT
      COUNT(*)
    FROM (
      SELECT
        j.e_k
      FROM joined AS j
      WHERE
        j.e_k IS NOT NULL AND j.grade IS NOT DISTINCT FROM g.grade
      GROUP BY
        j.e_k
    ) AS x
  ) AS emp_count,
  (
    SELECT
      SUM(x.sal)
    FROM (
      SELECT
        ANY_VALUE(j.e_sal) AS sal
      FROM joined AS j
      WHERE
        j.e_k IS NOT NULL AND j.grade IS NOT DISTINCT FROM g.grade
      GROUP BY
        j.e_k
    ) AS x
  ) AS sum_sal,
  (
    SELECT
      COUNT(*)
    FROM (
      SELECT
        j.d_k
      FROM joined AS j
      WHERE
        j.d_k IS NOT NULL AND j.grade IS NOT DISTINCT FROM g.grade
      GROUP BY
        j.d_k
    ) AS x
  ) AS dept_count
FROM spine AS g
ORDER BY
  g.grade
|_} : string
+-------+-----------+----------+------------+
| grade | emp_count | sum_sal  | dept_count |
+-------+-----------+----------+------------+
|     1 |         3 |  2850.00 |          2 |
|     2 |         3 |  3800.00 |          2 |
|     3 |         2 |  3100.00 |          1 |
|     4 |         5 | 14275.00 |          3 |
|     5 |         1 |  5000.00 |          1 |
+-------+-----------+----------+------------+

# End b07_three_way_join_fan_out.ost
