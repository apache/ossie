# Regression for apache/ossie#813: defining measures on the input relations
# must not prevent a JOIN that reads only fields. This query evaluates and
# passes through no measure.
connect("scott");
modelFile("scott_model", "scott/scott_model.ossie.yaml");
executeExpand(
  SELECT emp.ename, dept.dname
  FROM scott_model.emp
  LEFT JOIN scott_model.dept ON emp.deptno = dept.deptno
  WHERE emp.sal > 2900
  GROUP BY emp.ename, dept.dname
  ORDER BY emp.ename);
> {_|
SELECT
  emp.ename,
  dept.dname
FROM scott.emp
LEFT JOIN scott.dept
  ON emp.deptno = dept.deptno
WHERE
  emp.sal > 2900
GROUP BY
  emp.ename,
  dept.dname
ORDER BY
  emp.ename
|_} : string
+-------+------------+
| ename | dname      |
+-------+------------+
| FORD  | RESEARCH   |
| JONES | RESEARCH   |
| KING  | ACCOUNTING |
| SCOTT | RESEARCH   |
+-------+------------+

# Passing an unevaluated measure through the same JOIN is still unsupported.
executeExpand(
  SELECT emp.sum_sal
  FROM scott_model.emp
  LEFT JOIN scott_model.dept ON emp.deptno = dept.deptno);
> error: view expander does not support measures through a join yet

# A local subquery field can have the same name as an outer input measure.
executeExpand(
  SELECT e.ename, (SELECT sum_sal FROM (SELECT 1 AS sum_sal) t) AS n
  FROM scott_model.emp e
  JOIN scott_model.dept d ON e.deptno = d.deptno
  ORDER BY e.ename LIMIT 1);
> {_|
SELECT
  e.ename,
  (
    SELECT
      sum_sal
    FROM (
      SELECT
        1 AS sum_sal
    ) AS t
  ) AS n
FROM scott.emp AS e
JOIN scott.dept AS d
  ON e.deptno = d.deptno
ORDER BY
  e.ename
LIMIT 1
|_} : string
+-------+---+
| ename | n |
+-------+---+
| ADAMS | 1 |
+-------+---+

# Implicit JOIN keys must not use measures as scalar fields.
executeExpand(
  SELECT e.ename FROM scott_model.emp e
  JOIN (SELECT 1 AS sum_sal) t USING (sum_sal));
> error: view expander does not support measures as join keys

executeExpand(
  SELECT e.ename FROM scott_model.emp e
  NATURAL JOIN (SELECT 1 AS sum_sal) t);
> error: view expander does not support measures as join keys
