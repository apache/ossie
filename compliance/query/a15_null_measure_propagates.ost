# ============================================================================
# Compliance query A15
#
# A test case for core-spec/relational_semantics.md over the classic SCOTT
# schema, as an ost script (apache/ossie#501). The argument to
# executeExpand is the query under test. executeExpand expands it with
# the view expander (apache/ossie#502) into an equivalent DuckDB query
# over the datasets' source tables, and executes the expansion. The
# table that follows is the expected result. README.md gives the rules
# for cases.
#
# Part A: fundamentals (one relation). On one relation, no join repeats
# rows, so AGG(m) gives the same result as the aggregate of m's metric
# over the same rows.
#
# Run, from the root of the repository:
#   uv run --project ost ost -d compliance compliance/query/a15_null_measure_propagates.ost
#
# Expected-result format:
#   * NULL is shown as an empty cell.
#   * DOUBLE values are rounded to 2 decimal places.
#
# References:
#   * Spec: core-spec/relational_semantics.md (apache/ossie#354)
#   * Dataset-scoped metrics: apache/ossie#591
#   * Test format: apache/ossie#501. View expander: apache/ossie#502.
# ============================================================================

# The "scott" fixture has tables dept, emp, bonus, salgrade and pet in
# schema scott, with the same values as scott/scott.sql.
connect("scott");
set("doubleDigits", 2);

# The model is scott/scott_model.ossie.yaml; its comments describe it. Each
# dataset is a relation in schema scott_model, such as scott_model.emp.
modelFile("scott_model", "scott/scott_model.ossie.yaml");

# ----------------------------------------------------------------------------
# A15. A NULL measure value makes a scalar expression NULL.
# Question: For each department, what is the total of salaries and
#   commissions?
# Departments 10 and 20 have no commission values, so AGG(sum_comm) is NULL
# (case A6), and AGG(sum_sal) + AGG(sum_comm) is NULL by the standard SQL
# rule for NULL operands. The total is not AGG(sum_sal) alone, as it would
# be if a NULL operand counted as 0. Compare case A5, which uses COALESCE.
# Spec: 8.1
# ----------------------------------------------------------------------------
executeExpand(
  SELECT deptno,
         AGG(sum_sal) + AGG(sum_comm) AS total_pay
  FROM scott_model.emp
  GROUP BY deptno
  ORDER BY deptno);
> {_|
SELECT
  deptno,
  SUM(sal) + SUM(comm) AS total_pay
FROM scott.emp
GROUP BY
  deptno
ORDER BY
  deptno
|_} : string
+--------+-----------+
| deptno | total_pay |
+--------+-----------+
|     10 |           |
|     20 |           |
|     30 |  11600.00 |
+--------+-----------+

# End a15_null_measure_propagates.ost
