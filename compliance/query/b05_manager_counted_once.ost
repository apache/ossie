# ============================================================================
# Compliance queries B5, B5a
#
# A test case for core-spec/relational_semantics.md over the classic SCOTT
# schema, as an ost script (apache/ossie#501). The argument to
# executeExpand is the query under test. executeExpand expands it with
# the view expander (apache/ossie#502) into an equivalent DuckDB query
# over the datasets' source tables, and executes the expansion. The
# table that follows is the expected result. README.md gives the rules
# for cases.
#
# Case B5a uses the dataset pet.
#
# Part B: joins. A join can repeat a row of a measure's source (fan-out).
# An outer join can also add NULL-padded rows that come from no source row.
# AGG(m) aggregates each source row of m once and ignores NULL-padded rows
# (spec Section 8.1). The comments give the result of a plain aggregate over
# the joined rows ("naive") where it differs.
#
# The expansion follows the reference evaluation strategy of spec
# Section 9, as README.md describes.
#
# Run, from the root of the repository:
#   uv run --project ost ost -d compliance compliance/query/b05_manager_counted_once.ost
#
# Expected-result format:
#   * NULL is shown as an empty cell.
#   * DOUBLE values are rounded to 2 decimal places.
#
# References:
#   * Spec: core-spec/relational_semantics.md (apache/ossie#354)
#   * Dataset-scoped metrics: apache/ossie#591
#   * Test format: apache/ossie#501. View expander: apache/ossie#502.
# ============================================================================

# The "scott" fixture has tables dept, emp, bonus, salgrade and pet in
# schema scott, with the same values as scott/scott.sql.
connect("scott");
set("doubleDigits", 2);

# The model is scott/scott_model.ossie.yaml; its comments describe it. Each
# dataset is a relation in schema scott_model, such as scott_model.emp.
modelFile("scott_model", "scott/scott_model.ossie.yaml");

# ----------------------------------------------------------------------------
# B5. Fan-out in a self-join: each manager is counted once.
# Question: For each job, how many employees have a manager, how many
#   managers do they report to, and what is the total salary of those
#   managers?
# e is the employee and m is the manager. The join repeats each manager row
# once for each report. AGG(m.sum_sal) counts the salary of each manager once
# in each group. The 4 salesmen all report to BLAKE, so the result is 2850,
# and a plain SUM(m.sal) gives 11400. The 4 clerks report to 4 different
# managers, so the two values are the same (11300). A plain SUM(m.sal) by job
# gives 5950, 11300, 15000, 11400.
# Spec: 7.6, 8.1, G2 (8.3)
# ----------------------------------------------------------------------------
executeExpand(
  SELECT e.job,
         AGG(e.emp_count) AS emp_count,
         AGG(m.emp_count) AS managers,
         AGG(m.sum_sal) AS managers_sal
  FROM scott_model.emp AS e
  JOIN scott_model.emp AS m ON e.mgr = m.empno
  GROUP BY e.job
  ORDER BY e.job);
> {_|
WITH joined AS (
  SELECT
    e.job AS job,
    e.empno AS e_k,
    m.empno AS m_k,
    m.sal AS m_sal
  FROM scott.emp AS e
  JOIN scott.emp AS m
    ON e.mgr = m.empno
), spine AS (
  SELECT DISTINCT
    job
  FROM joined
)
SELECT
  g.job,
  (
    SELECT
      COUNT(*)
    FROM (
      SELECT
        j.e_k
      FROM joined AS j
      WHERE
        j.e_k IS NOT NULL AND j.job IS NOT DISTINCT FROM g.job
      GROUP BY
        j.e_k
    ) AS x
  ) AS emp_count,
  (
    SELECT
      COUNT(*)
    FROM (
      SELECT
        j.m_k
      FROM joined AS j
      WHERE
        j.m_k IS NOT NULL AND j.job IS NOT DISTINCT FROM g.job
      GROUP BY
        j.m_k
    ) AS x
  ) AS managers,
  (
    SELECT
      SUM(x.sal)
    FROM (
      SELECT
        ANY_VALUE(j.m_sal) AS sal
      FROM joined AS j
      WHERE
        j.m_k IS NOT NULL AND j.job IS NOT DISTINCT FROM g.job
      GROUP BY
        j.m_k
    ) AS x
  ) AS managers_sal
FROM spine AS g
ORDER BY
  g.job
|_} : string
+----------+-----------+----------+--------------+
| job      | emp_count | managers | managers_sal |
+----------+-----------+----------+--------------+
| ANALYST  |         2 |        1 |      2975.00 |
| CLERK    |         4 |        4 |     11300.00 |
| MANAGER  |         3 |        1 |      5000.00 |
| SALESMAN |         4 |        1 |      2850.00 |
+----------+-----------+----------+--------------+

# ----------------------------------------------------------------------------
# B5a. Fan-out: the owners' salary, by species of pet.
# The join repeats each owner once for each of their pets of the species.
# JONES has two cats, so the join repeats JONES in the CAT group, and
# AGG(e.sum_sal) counts JONES's salary once. Naive SUM(e.sal) for CAT is
# 11950. SUM(DISTINCT e.sal) is no remedy: it gives 5975, because FORD and
# SCOTT have the same salary.
# Spec: 7.6, 8.1, G2 (8.3)
# ----------------------------------------------------------------------------
executeExpand(
  SELECT p.species,
         AGG(e.emp_count) AS owners,
         AGG(e.sum_sal) AS owners_sal,
         AGG(p.pet_count) AS pets,
         AGG(p.sum_age) AS sum_age
  FROM scott_model.emp AS e
  JOIN scott_model.pet AS p ON p.empno = e.empno
  GROUP BY p.species
  ORDER BY p.species);
> {_|
WITH joined AS (
  SELECT
    p.species AS species,
    e.empno AS e_k,
    e.sal AS e_sal,
    p.pname AS p_k,
    p.age AS p_age
  FROM scott.emp AS e
  JOIN scott.pet AS p
    ON p.empno = e.empno
), spine AS (
  SELECT DISTINCT
    species
  FROM joined
)
SELECT
  g.species,
  (
    SELECT
      COUNT(*)
    FROM (
      SELECT
        j.e_k
      FROM joined AS j
      WHERE
        j.e_k IS NOT NULL AND j.species IS NOT DISTINCT FROM g.species
      GROUP BY
        j.e_k
    ) AS x
  ) AS owners,
  (
    SELECT
      SUM(x.sal)
    FROM (
      SELECT
        ANY_VALUE(j.e_sal) AS sal
      FROM joined AS j
      WHERE
        j.e_k IS NOT NULL AND j.species IS NOT DISTINCT FROM g.species
      GROUP BY
        j.e_k
    ) AS x
  ) AS owners_sal,
  (
    SELECT
      COUNT(*)
    FROM (
      SELECT
        j.p_k
      FROM joined AS j
      WHERE
        j.p_k IS NOT NULL AND j.species IS NOT DISTINCT FROM g.species
      GROUP BY
        j.p_k
    ) AS x
  ) AS pets,
  (
    SELECT
      SUM(x.age)
    FROM (
      SELECT
        ANY_VALUE(j.p_age) AS age
      FROM joined AS j
      WHERE
        j.p_k IS NOT NULL AND j.species IS NOT DISTINCT FROM g.species
      GROUP BY
        j.p_k
    ) AS x
  ) AS sum_age
FROM spine AS g
ORDER BY
  g.species
|_} : string
+---------+--------+------------+------+---------+
| species | owners | owners_sal | pets | sum_age |
+---------+--------+------------+------+---------+
| CAT     |      3 |    8975.00 |    4 |      15 |
| DOG     |      2 |    4575.00 |    2 |      14 |
| HAMSTER |      1 |    1100.00 |    1 |       1 |
+---------+--------+------------+------+---------+

# End b05_manager_counted_once.ost
