# ============================================================================
# Compliance query B16
#
# A test case for core-spec/relational_semantics.md over the classic SCOTT
# schema, as an ost script (apache/ossie#501). The argument to
# executeExpand is the query under test. executeExpand expands it with
# the view expander (apache/ossie#502) into an equivalent DuckDB query
# over the datasets' source tables, and executes the expansion. The
# table that follows is the expected result. README.md gives the rules
# for cases.
#
# Part B: joins. A join can repeat a row of a measure's source (fan-out).
# An outer join can also add NULL-padded rows that come from no source row.
# AGG(m) aggregates each source row of m once and ignores NULL-padded rows
# (spec Section 8.1). The comments give the result of a plain aggregate over
# the joined rows ("naive") where it differs.
#
# The expansion follows the reference evaluation strategy of spec
# Section 9, as README.md describes.
#
# Run, from the root of the repository:
#   uv run --project ost ost -d compliance compliance/query/b16_on_filter_keeps_left_rows.ost
#
# Expected-result format:
#   * NULL is shown as an empty cell.
#   * DOUBLE values are rounded to 2 decimal places.
#
# References:
#   * Spec: core-spec/relational_semantics.md (apache/ossie#354)
#   * Dataset-scoped metrics: apache/ossie#591
#   * Test format: apache/ossie#501. View expander: apache/ossie#502.
# ============================================================================

# The "scott" fixture has tables dept, emp, bonus, salgrade and pet in
# schema scott, with the same values as scott/scott.sql.
connect("scott");
set("doubleDigits", 2);

# The model is scott/scott_model.ossie.yaml; its comments describe it. Each
# dataset is a relation in schema scott_model, such as scott_model.emp.
modelFile("scott_model", "scott/scott_model.ossie.yaml");

# ----------------------------------------------------------------------------
# B14-B17. One dept-emp query with inner and outer joins.
#
# The query computes the payroll per department as a ratio of two measures
# from different relations: AGG(e.sum_sal) / AGG(d.dept_count). The join
# repeats each dept row once for each employee in it (fan-out), but
# dept_count still counts each department once. Naive COUNT(d.deptno) is 14
# for INNER and 15 for LEFT.
#
# The join type is the tool's choice, and it changes the answer (spec 10.2,
# A.6). The LEFT join keeps OPERATIONS, which has no employees, so the
# payroll is divided by 4 departments and not by 3. A filter in the ON clause
# of the LEFT join keeps all 4 departments but matches only the clerks.
# A RIGHT join with the sides swapped, or a FULL join, gives the LEFT
# result, because every employee has a department.
# Spec: 7.2, 7.6, 8.1, A.6
# ----------------------------------------------------------------------------

# ----------------------------------------------------------------------------
# B16. A filter in the ON clause of a LEFT JOIN keeps every left row.
# Question: What is the payroll of the clerks per department, over all
#   departments?
# B14 to B16 run one dept-emp query with different joins. The query divides
# the payroll by the number of departments: a ratio of two measures from
# different relations. The join repeats each dept row once for each employee
# in the department, but dept_count still counts each department once. The
# CAST makes the division approximate (README, "Result semantics").
#
# The condition e.job = 'CLERK' in ON keeps every department and matches only
# clerks. If the condition were in WHERE, the query would remove the
# NULL-padded OPERATIONS row, and dept_count would be 3.
# Spec: 7.2, 7.6, 8.1, A.6
# ----------------------------------------------------------------------------
executeExpand(
  SELECT AGG(d.dept_count) AS dept_count,
         AGG(e.emp_count) AS emp_count,
         AGG(e.sum_sal) AS sum_sal,
         CAST(AGG(e.sum_sal) AS DOUBLE) / AGG(d.dept_count) AS sal_per_dept
  FROM scott_model.dept AS d
  LEFT JOIN scott_model.emp AS e ON e.deptno = d.deptno AND e.job = 'CLERK');
> {_|
WITH joined AS (
  SELECT
    d.deptno AS d_k,
    e.empno AS e_k,
    e.sal AS e_sal
  FROM scott.dept AS d
  LEFT JOIN scott.emp AS e
    ON e.deptno = d.deptno AND e.job = 'CLERK'
)
SELECT
  (
    SELECT
      COUNT(*)
    FROM (
      SELECT
        j.d_k
      FROM joined AS j
      WHERE
        j.d_k IS NOT NULL
      GROUP BY
        j.d_k
    ) AS x
  ) AS dept_count,
  (
    SELECT
      COUNT(*)
    FROM (
      SELECT
        j.e_k
      FROM joined AS j
      WHERE
        j.e_k IS NOT NULL
      GROUP BY
        j.e_k
    ) AS x
  ) AS emp_count,
  (
    SELECT
      SUM(x.sal)
    FROM (
      SELECT
        ANY_VALUE(j.e_sal) AS sal
      FROM joined AS j
      WHERE
        j.e_k IS NOT NULL
      GROUP BY
        j.e_k
    ) AS x
  ) AS sum_sal,
  CAST((
    SELECT
      SUM(x.sal)
    FROM (
      SELECT
        ANY_VALUE(j.e_sal) AS sal
      FROM joined AS j
      WHERE
        j.e_k IS NOT NULL
      GROUP BY
        j.e_k
    ) AS x
  ) AS DOUBLE) / (
    SELECT
      COUNT(*)
    FROM (
      SELECT
        j.d_k
      FROM joined AS j
      WHERE
        j.d_k IS NOT NULL
      GROUP BY
        j.d_k
    ) AS x
  ) AS sal_per_dept
|_} : string
+------------+-----------+---------+--------------+
| dept_count | emp_count | sum_sal | sal_per_dept |
+------------+-----------+---------+--------------+
|          4 |         4 | 4150.00 |      1037.50 |
+------------+-----------+---------+--------------+

# End b16_on_filter_keeps_left_rows.ost
