# ============================================================================
# Wide table compliance case e16
#
# A test case for core-spec/wide_table_semantics.md, the Wide Table Query
# Interface (Layer 3), as an ost script (apache/ossie#501). The argument to
# executeLower is the query under test, in the JSON binding of Section 3.7.
# executeLower lowers it to a Layer 2 query (Section 5), and the lowering
# raises an error of Section 8. The case requires only the code at the
# start of the error. README.md gives the rules for cases.
#
# Run, from the root of the repository:
#   uv run --project ost ost -d compliance compliance/wide_table/e16_partial_dimension_reachability.ost
# ============================================================================

# The "retail" fixture has the tables and values of retail/retail.sql.
connect("retail");
set("doubleDigits", 2);

# The model is retail/retail_model.ossie.yaml.
modelFile("retail_model", "retail/retail_model.ossie.yaml");

# ----------------------------------------------------------------------------
# e16. A dimension some metrics reach.
# Question: What are the order amount and the number of tickets by customer
# region?
# orders reaches customers; tickets does not. The error names customers.region
# and tickets.ticket_count.
# Spec: 5.3, 8, B.4
# ----------------------------------------------------------------------------
executeLower("retail_model", {
  "dimensions": ["customers.region"],
  "metrics": ["orders.total_revenue", "tickets.ticket_count"]
});
> error: E_PARTIAL_DIMENSION_REACHABILITY: metric tickets.ticket_count does not reach customers, the dataset of dimension customers.region

# End e16_partial_dimension_reachability.ost
