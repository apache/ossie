# ============================================================================
# Wide table compliance case a07
#
# A test case for core-spec/wide_table_semantics.md, the Wide Table Query
# Interface (Layer 3), as an ost script (apache/ossie#501). The argument to
# executeLower is the query under test, in the JSON binding of Section 3.7.
# executeLower lowers it to a Layer 2 query (Section 5), expands that query
# with the view expander (apache/ossie#502), and executes the expansion. The
# table that follows is the expected result. README.md gives the rules for
# cases.
#
# Run, from the root of the repository:
#   uv run --project ost ost -d compliance compliance/wide_table/a07_dimension_only.ost
# ============================================================================

# The "retail" fixture has the tables and values of retail/retail.sql.
connect("retail");
set("doubleDigits", 2);

# The model is retail/retail_model.ossie.yaml.
modelFile("retail_model", "retail/retail_model.ossie.yaml");

# ----------------------------------------------------------------------------
# a07. A query without metrics uses an anchor.
# Question: Which customer regions are there?
# The anchor is customers, the dataset of the only dimension. The result has
# its distinct regions.
# Spec: 3.2, 5.6, 6.1
# ----------------------------------------------------------------------------
executeLower("retail_model", {
  "dimensions": ["customers.region"]
});
> {_|
SELECT
  customers.region
FROM retail_model.customers
GROUP BY
  customers.region
|_} : string
+--------+
| region |
+--------+
| WEST   |
| EAST   |
| NORTH  |
+--------+

# End a07_dimension_only.ost
