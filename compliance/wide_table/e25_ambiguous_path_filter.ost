# ============================================================================
# Wide table compliance case e25
#
# A test case for core-spec/wide_table_semantics.md, the Wide Table Query
# Interface (Layer 3), as an ost script (apache/ossie#501). The argument to
# executeLower is the query under test, in the JSON binding of Section 3.7.
# executeLower lowers it to a Layer 2 query (Section 5), and the lowering
# raises an error of Section 8. The case requires only the code at the
# start of the error. README.md gives the rules for cases.
#
# Run, from the root of the repository:
#   uv run --project ost ost -d compliance compliance/wide_table/e25_ambiguous_path_filter.ost
# ============================================================================

# The "stores" fixture has the tables and values of stores/stores.sql.
connect("stores");
set("doubleDigits", 2);

# The model is stores/stores_ambiguous_model.ossie.yaml.
modelFile("stores_ambiguous_model", "stores/stores_ambiguous_model.ossie.yaml");

# ----------------------------------------------------------------------------
# e25. A filter on date_dim is ambiguous from store_sales.
# Question: What is the total sales amount for year 2024?
# The filter's dataset is date_dim. store_sales has two paths to it, so the
# join tree is ambiguous. Appendix B.3.
# Spec: 4, 5.3, 8, B.3
# ----------------------------------------------------------------------------
executeLower("stores_ambiguous_model", {
  "metrics": ["store_sales.total_sales"],
  "filter": "date_dim.year = 2024"
});
> error: E_AMBIGUOUS_PATH: 2 paths lead from store_sales to date_dim

# End e25_ambiguous_path_filter.ost
