# ============================================================================
# Wide table compliance case a16
#
# A test case for core-spec/wide_table_semantics.md, the Wide Table Query
# Interface (Layer 3), as an ost script (apache/ossie#501). The argument to
# executeLower is the query under test, in the JSON binding of Section 3.7.
# executeLower lowers it to a Layer 2 query (Section 5), expands that query
# with the view expander (apache/ossie#502), and executes the expansion. The
# table that follows is the expected result. README.md gives the rules for
# cases.
#
# Run, from the root of the repository:
#   uv run --project ost ost -d compliance compliance/wide_table/a16_shared_dimensions_stores.ost
# ============================================================================

# The "stores" fixture has the tables and values of stores/stores.sql.
connect("stores");
set("doubleDigits", 2);

# The model is stores/stores_model.ossie.yaml.
modelFile("stores_model", "stores/stores_model.ossie.yaml");

# ----------------------------------------------------------------------------
# a16. Two fact metrics share item and date dimensions.
# Question: What are the sales and return amounts by item brand and year?
# store_sales and store_returns each form a branch to item and date_dim. Keys
# are the brand and year pairs from either branch. Acme in 2024 has sales and
# no returns, so total_returns is NULL. Appendix B.3 shared dimensions.
# Spec: 4, 5.4, 5.5, B.3
# ----------------------------------------------------------------------------
# The view expander cannot expand this lowering yet. The output is the
# lowering and the expected result.
skip("https://github.com/apache/ossie/issues/814");
executeLower("stores_model", {
  "dimensions": ["item.brand", "date_dim.year"],
  "metrics": ["store_sales.total_sales", "store_returns.total_returns"]
});
> {_|
WITH b_store_sales AS (
  SELECT
    item.brand,
    date_dim.year,
    AGG(store_sales.total_sales) AS total_sales
  FROM stores_model.store_sales
  LEFT JOIN stores_model.item
    ON store_sales.item_id = item.item_id
  LEFT JOIN stores_model.date_dim
    ON store_sales.sale_date_id = date_dim.date_id
  GROUP BY
    item.brand,
    date_dim.year
), b_store_returns AS (
  SELECT
    item.brand,
    date_dim.year,
    AGG(store_returns.total_returns) AS total_returns
  FROM stores_model.store_returns
  LEFT JOIN stores_model.item
    ON store_returns.item_id = item.item_id
  LEFT JOIN stores_model.date_dim
    ON store_returns.return_date_id = date_dim.date_id
  GROUP BY
    item.brand,
    date_dim.year
), keys AS (
  SELECT
    brand,
    year
  FROM b_store_sales
  UNION
  SELECT
    brand,
    year
  FROM b_store_returns
)
SELECT
  keys.brand,
  keys.year,
  b_store_sales.total_sales,
  b_store_returns.total_returns
FROM keys
LEFT JOIN b_store_sales
  ON b_store_sales.brand IS NOT DISTINCT FROM keys.brand
  AND b_store_sales.year IS NOT DISTINCT FROM keys.year
LEFT JOIN b_store_returns
  ON b_store_returns.brand IS NOT DISTINCT FROM keys.brand
  AND b_store_returns.year IS NOT DISTINCT FROM keys.year
|_} : string
+-------+------+-------------+---------------+
| brand | year | total_sales | total_returns |
+-------+------+-------------+---------------+
| Acme  | 2023 |         125 |            10 |
| Acme  | 2024 |         200 |               |
| Beta  | 2024 |          90 |             5 |
+-------+------+-------------+---------------+

# End a16_shared_dimensions_stores.ost
