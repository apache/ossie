# ============================================================================
# Wide table compliance case a20
#
# A test case for core-spec/wide_table_semantics.md, the Wide Table Query
# Interface (Layer 3), as an ost script (apache/ossie#501). The argument to
# executeLower is the query under test, in the JSON binding of Section 3.7.
# executeLower lowers it to a Layer 2 query (Section 5), expands that query
# with the view expander (apache/ossie#502), and executes the expansion. The
# table that follows is the expected result. README.md gives the rules for
# cases.
#
# Run, from the root of the repository:
#   uv run --project ost ost -d compliance compliance/wide_table/a20_filter_on_sale_year.ost
# ============================================================================

# The "stores" fixture has the tables and values of stores/stores.sql.
connect("stores");
set("doubleDigits", 2);

# The model is stores/stores_model.ossie.yaml.
modelFile("stores_model", "stores/stores_model.ossie.yaml");

# ----------------------------------------------------------------------------
# a20. A filter on date_dim with one path.
# Question: What is the total sales amount for year 2024?
# store_sales reaches date_dim only through sale_date_id, so the filter
# applies. Sales in 2024 are 200 + 50 + 40 = 290. The same query against
# stores_ambiguous raises E_AMBIGUOUS_PATH (e25).
# Spec: 4, 5.3, 5.4, B.3
# ----------------------------------------------------------------------------
# The view expander cannot expand this lowering yet. The output is the
# lowering and the expected result.
skip("https://github.com/apache/ossie/issues/814");
executeLower("stores_model", {
  "metrics": ["store_sales.total_sales"],
  "filter": "date_dim.year = 2024"
});
> {_|
SELECT
  AGG(store_sales.total_sales) AS total_sales
FROM stores_model.store_sales
LEFT JOIN stores_model.date_dim
  ON store_sales.sale_date_id = date_dim.date_id
WHERE
  date_dim.year = 2024
|_} : string
+-------------+
| total_sales |
+-------------+
|         290 |
+-------------+

# End a20_filter_on_sale_year.ost
