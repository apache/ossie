# Tests for how the runner formats values of each type.

# Integers and decimals.
select 1::hugeint as c;
+---+
| c |
+---+
| 1 |
+---+
(1 row)
select -0.50::decimal(5, 2) as c;
+-------+
| c     |
+-------+
| -0.50 |
+-------+
(1 row)

# Floating point.
select 0.1::real as c;
+-----+
| c   |
+-----+
| 0.1 |
+-----+
(1 row)
select 0.1::double + 0.2::double as c;
+---------------------+
| c                   |
+---------------------+
| 0.30000000000000004 |
+---------------------+
(1 row)
select 1e16::double as c;
+-------+
| c     |
+-------+
| 1e+16 |
+-------+
(1 row)
select 'inf'::double as c;
+-----+
| c   |
+-----+
| inf |
+-----+
(1 row)

# Strings are quoted if they are empty or contain special characters.
# NULL is an empty cell.
select 'a b' as s union all select '' union all select null;
+-----+
| s   |
+-----+
| a b |
| ""  |
|     |
+-----+
(3 rows)
select 'a|b' as c;
+-------+
| c     |
+-------+
| "a|b" |
+-------+
(1 row)
select 'x' || chr(10) || 'y' as c;
+--------+
| c      |
+--------+
| "x\ny" |
+--------+
(1 row)

# Booleans.
select true as c;
+------+
| c    |
+------+
| true |
+------+
(1 row)

# Dates and times. TIMESTAMPTZ is printed in UTC.
select date '2024-03-10' as c;
+------------+
| c          |
+------------+
| 2024-03-10 |
+------------+
(1 row)
select time '12:34:56' as c;
+----------+
| c        |
+----------+
| 12:34:56 |
+----------+
(1 row)
select timestamp '2024-03-10 12:34:56.5' as c;
+-----------------------+
| c                     |
+-----------------------+
| 2024-03-10 12:34:56.5 |
+-----------------------+
(1 row)
select timestamptz '2024-03-10 12:34:56+05' as c;
+------------------------+
| c                      |
+------------------------+
| 2024-03-10 07:34:56+00 |
+------------------------+
(1 row)

# Intervals use ISO 8601 format.
select interval '25 hours' as c;
+--------+
| c      |
+--------+
| P1DT1H |
+--------+
(1 row)
select interval '0 seconds' as c;
+------+
| c    |
+------+
| PT0S |
+------+
(1 row)
select interval '-1 hour' as c;
+-------+
| c     |
+-------+
| -PT1H |
+-------+
(1 row)
select interval '3 days 4 hours 5 minutes 6.5 seconds' as c;
+--------------+
| c            |
+--------------+
| P3DT4H5M6.5S |
+--------------+
(1 row)
select interval '2 days' as c;
+-----+
| c   |
+-----+
| P2D |
+-----+
(1 row)

# A type that ost cannot format is an error.
select [1] as l;
> error: ost: unsupported type INTEGER[]

# End types.ost
