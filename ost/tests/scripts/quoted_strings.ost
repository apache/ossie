# DuckDB escape strings can contain quotes and semicolons.
SELECT E'a\'b;c' AS value;
+-------+
| value |
+-------+
| a'b;c |
+-------+

# The lowercase escape-string prefix is equivalent.
SELECT e'a\'b;c' AS value;
+-------+
| value |
+-------+
| a'b;c |
+-------+

# Dollar-quoted strings can span lines and contain semicolons.
SELECT $$first;
second$$ AS value;
+------------------+
| value            |
+------------------+
| "first;\nsecond" |
+------------------+

# A tagged delimiter can contain an untagged dollar delimiter.
SELECT $tag$first;
$$ middle $tag$ AS value;
+----------------------+
| value                |
+----------------------+
| "first;\n$$ middle " |
+----------------------+

# A dollar sign inside an identifier is not a dollar-quoted string.
SELECT 1 AS foo$bar$;
+----------+
| foo$bar$ |
+----------+
|        1 |
+----------+
