Dataset aql_translation {
  label: 'Aql Translation'
  description: 'Metrics that exercise each path through the SQL to AQL translation'
  data_source_name: 'bigquery_demo'

  models: [
    orders,
    items,
    users,
  ]

  relationships: [
    relationship(items.order_id > orders.id, true),
    relationship(orders.user_id > users.id, true),
  ]

  metric quantity_per_customer {
    label: 'Quantity Per Customer'
    type: 'number'
    description: 'The plain path. SUM and COUNT DISTINCT both have AQL names'
    definition: @aql sum(items.quantity) / count_distinct(users.id);;
  }

  metric rounded_ratio {
    label: 'Rounded Ratio'
    type: 'number'
    description: 'Functions AQL has. ROUND, SAFE_DIVIDE and ABS are written natively'
    definition: @aql round(safe_divide(sum(items.quantity), abs(count(users.id))), 2);;
  }

  metric untyped_total {
    label: 'Untyped Total'
    type: 'number'
    description: 'A field with no datatype, summed, so the metric is what types it'
    definition: @aql sum(items.product_id) + count(users.id);;
  }

  metric borrowed_column_total {
    label: 'Borrowed Column Total'
    type: 'number'
    description: 'A column no dataset declares as a field, so one is added for it'
    definition: @aql sum(items.sale_price) + count(users.id);;
  }

  metric passthrough_call {
    label: 'Passthrough Call'
    type: 'number'
    description: 'A function sqlglot does not model, carried by AQL\'s raw-SQL call'
    definition: @aql sum(items.quantity) + sql_number('MY_WAREHOUSE_UDF', count(users.id), 3);;
  }
}
