Model items {
  type: 'table'
  label: 'Items'
  data_source_name: 'bigquery_demo'
  table_name: '`ecommerce`.`order_items`'

  dimension id {
    label: 'Id'
    type: 'number'
    definition: @sql {{ #SOURCE.id }};;
    primary_key: true
  }

  dimension order_id {
    label: 'Order Id'
    type: 'number'
    definition: @sql {{ #SOURCE.order_id }};;
  }

  dimension quantity {
    label: 'Quantity'
    type: 'number'
    definition: @sql {{ #SOURCE.quantity }};;
  }

  measure items_quantity {
    label: 'Items Quantity'
    type: 'number'
    description: 'A plain measure on one model, which the metrics below reference'
    definition: @sql SUM({{ quantity }});;
    aggregation_type: 'custom'
  }

  measure quantity_plus_one {
    label: 'Quantity Plus One'
    type: 'number'
    description: 'A body naming only another metric, so placement follows the reference'
    definition: @sql {{ items_quantity }} + 1;;
    aggregation_type: 'custom'
  }
}
