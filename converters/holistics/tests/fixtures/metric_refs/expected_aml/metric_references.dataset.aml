Dataset metric_references {
  label: 'Metric References'
  description: 'Metrics that name other metrics, across both AML metric homes'
  data_source_name: 'bigquery_demo'

  models: [
    orders,
    items,
    users,
  ]

  relationships: [
    relationship(items.order_id > orders.id, true),
    relationship(orders.user_id > users.id, true),
  ]

  metric quantity_per_customer {
    label: 'Quantity Per Customer'
    type: 'number'
    description: 'A body spanning two datasets, so AML takes it only as AQL'
    definition: @aql sum(items.quantity) / count(users.id);;
  }

  metric half_quantity_per_customer {
    label: 'Half Quantity Per Customer'
    type: 'number'
    description: 'An AQL metric naming another AQL metric, which AQL takes by bare name'
    definition: @aql quantity_per_customer / 2;;
  }

  metric quantity_and_customers {
    label: 'Quantity And Customers'
    type: 'number'
    description: 'An AQL metric naming a measure, which AQL takes qualified by its model'
    definition: @aql items.items_quantity + count(users.id);;
  }

  metric scaled_quantity_per_customer {
    label: 'Scaled Quantity Per Customer'
    type: 'number'
    description: 'A SQL body naming an AQL metric, so the body becomes AQL as well'
    definition: @aql sum(items.quantity) * quantity_per_customer;;
  }
}
