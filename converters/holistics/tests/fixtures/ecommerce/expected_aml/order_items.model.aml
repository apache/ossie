Model order_items {
  type: 'table'
  label: 'Order Items'
  description: 'One row per line item on an order.'
  data_source_name: 'bigquery_demo'
  table_name: '`ecommerce`.`order_items`'

  dimension order_id {
    label: 'Order Id'
    type: 'number'
    definition: @sql {{ #SOURCE.order_id }};;
  }

  dimension product_id {
    label: 'Product Id'
    type: 'number'
    definition: @sql {{ #SOURCE.product_id }};;
  }

  dimension quantity {
    label: 'Quantity'
    type: 'number'
    definition: @sql {{ #SOURCE.quantity }};;
  }

  measure total_quantity {
    label: 'Total Quantity'
    type: 'number'
    definition: @sql {{ #SOURCE.quantity }};;
    aggregation_type: 'sum'
  }

  measure custom_total_quantity {
    label: 'Custom Total Quantity'
    type: 'number'
    definition: @sql sum({{ #SOURCE.quantity }});;
    aggregation_type: 'custom'
  }

  owner: 'dev@ossie.apache.org'
}
