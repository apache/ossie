Model cities {
  type: 'table'
  label: 'Cities'
  description: 'One row per city a merchant can operate in.'
  data_source_name: 'bigquery_demo'
  table_name: '`ecommerce`.`cities`'

  dimension id {
    label: 'Id'
    type: 'number'
    definition: @sql {{ #SOURCE.id }};;
    primary_key: true
  }

  dimension name {
    label: 'Name'
    type: 'text'
    definition: @sql {{ #SOURCE.name }};;
  }

  dimension country_code {
    label: 'Country Code'
    type: 'text'
    definition: @sql {{ #SOURCE.country_code }};;
  }

  dimension in_vietnam {
    label: 'In Vietnam'
    type: 'truefalse'
    definition: @aql cities.country_code == 'VN';;
  }

  measure upstream_measure {
    label: 'Upstream Measure'
    type: 'number'
    definition: @sql COUNT({{ id }});;
    aggregation_type: 'custom'
  }

  measure downstream_measure {
    label: 'Downstream Measure'
    type: 'number'
    definition: @sql {{ upstream_measure }} + 1;;
    aggregation_type: 'custom'
  }

  owner: 'dev@ossie.apache.org'
}
