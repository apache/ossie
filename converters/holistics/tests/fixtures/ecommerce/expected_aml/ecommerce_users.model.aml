Model ecommerce_users {
  type: 'query'
  label: 'Users'
  description: 'One row per registered customer.'
  data_source_name: 'bigquery_demo'

  query: @sql select * from `ecommerce`.`users`;;

  param reporting_currency {
    label: 'Reporting Currency'
    type: 'text'
  }

  param minimum_age {
    label: 'Minimum Age'
    type: 'number'
  }

  persistence: FullPersistence {
    on_cascade: 'rebuild'
    schema: 'persisted'
  }

  dimension id {
    label: 'Id'
    type: 'number'
    definition: @sql {{ #SOURCE.id }};;
    primary_key: true
  }

  dimension full_name {
    label: 'Full Name'
    type: 'text'
    definition: @sql {{ #SOURCE.full_name }};;
  }

  dimension gender {
    label: 'Gender'
    type: 'text'
    definition: @sql {{ #SOURCE.gender }};;
  }

  dimension birth_date {
    label: 'Birth Date'
    type: 'date'
    definition: @sql {{ #SOURCE.birth_date }};;
  }

  dimension age {
    label: 'Age'
    type: 'number'
    definition: @sql extract(year from age({{ birth_date }}));;
  }

  dimension age_bucket {
    label: 'Age Bucket'
    type: 'number'
    hidden: true
    definition: @sql FLOOR({{ age }} / 10);;
  }

  dimension signup_month {
    label: 'Signup Month'
    type: 'datetime'
    definition: @sql DATE_TRUNC({{ #SOURCE.created_at }}, month);;
  }

  measure count_users {
    label: 'Count Users'
    type: 'number'
    definition: @sql {{ #SOURCE.id }};;
    aggregation_type: 'count distinct'
  }

  owner: 'dev@ossie.apache.org'
}
