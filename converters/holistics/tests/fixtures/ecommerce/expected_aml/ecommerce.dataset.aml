Relationship delivered_orders_to_ecommerce_users {
  type: 'many_to_one'
  from: ref('delivered_orders', 'user_id')
  to: ref('ecommerce_users', 'id')
  where {
    from: @aql delivered_orders.delivery_attempts > 0 ;;
    to: @aql ecommerce_users.age > 18 ;;
  }
}
ManyToManyRelationship orders_in_year {
  type: 'many_to_many'
  from: ref('ecommerce_orders', 'id')
  to: ref('reporting.calendar', 'date')
  match: @aql ecommerce_orders.created_date == reporting.calendar.date ;;
}

Dataset ecommerce {
  label: 'Ecommerce'
  description: 'A marketplace model: orders, line items, products, merchants and cities.'
  data_source_name: 'bigquery_demo'

  models: [
    ecommerce_orders,
    ecommerce_users,
    order_items,
    products,
    merchants,
    cities,
    reporting.calendar,
    delivered_orders,
  ]

  relationships: [
    relationship(order_items.order_id > ecommerce_orders.id, true),
    relationship(order_items.product_id > products.id, true),
    relationship(ecommerce_orders.user_id > ecommerce_users.id, true),
    RelationshipConfig {
      rel: EqualityRelationship {
        type: 'many_to_one'
        from: ref('products', 'merchant_id')
        to: ref('merchants', 'id')
      }
      active: true
      direction: 'one_way'
      nullable: false
      rlp_propagation: 'one_way'
    },
    RelationshipConfig {
      rel: EqualityRelationship {
        type: 'many_to_one'
        from: ref('merchants', 'city_id')
        to: ref('cities', 'id')
        on {
          from: ref('merchants', 'country_code')
          to: ref('cities', 'country_code')
        }
      }
      active: true
    },
    RelationshipConfig {
      rel: delivered_orders_to_ecommerce_users
      active: true
    },
    relationship(merchants.admin_id - ecommerce_users.id, true),
    relationship(ecommerce_orders.created_date > reporting.calendar.date, false),
    RelationshipConfig {
      rel: orders_in_year
      active: true
    },
  ]

  dimension item_value {
    model: order_items
    label: 'Item Value'
    type: 'number'
    definition: @aql order_items.quantity * products.price;;
  }

  metric total_revenue {
    label: 'Total Revenue'
    type: 'number'
    definition: @aql sum(order_items.item_value);;
    format: '#,###[$$]'
  }

  metric count_orders {
    label: 'Count Orders'
    type: 'number'
    definition: @aql count(order_items.order_id);;
  }

  metric revenue_share_of_all_merchants {
    label: 'Revenue Share Of All Merchants'
    type: 'number'
    definition: @aql
      sum(order_items.item_value)
      / (sum(order_items.item_value) | of_all(merchants))
    ;;
  }

  owner: 'dev@ossie.apache.org'
}
