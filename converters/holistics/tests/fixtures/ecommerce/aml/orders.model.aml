Model ecommerce_orders {
  type: 'table'
  label: 'Orders'
  description: 'One row per customer order.'
  data_source_name: 'bigquery_demo'
  table_name: '`ecommerce`.`orders`'

  // No definition: the dimension name is the column name.
  dimension id {
    label: 'Id'
    type: 'number'
    primary_key: true
  }

  dimension user_id {
    label: 'User Id'
    type: 'number'
    definition: @sql {{ #SOURCE.user_id }};;
  }

  dimension created_at {
    label: 'Created At'
    type: 'datetime'
    definition: @sql {{ #SOURCE.created_at }};;
  }

  // Warehouse SQL, not portable ANSI.
  dimension created_date {
    label: 'Created Date'
    type: 'date'
    definition: @sql CAST({{ #SOURCE.created_at }} AS DATE);;
  }

  // BigQuery argument order; a converter must not rewrite this.
  dimension created_month {
    label: 'Created Month'
    type: 'date'
    definition: @sql DATE_TRUNC({{ #SOURCE.created_at }}, month);;
    format: 'dd LLL, yyyy'
  }

  dimension status {
    label: 'Status'
    type: 'text'
    definition: @sql {{ #SOURCE.status }};;
  }

  dimension delivered {
    label: 'Delivered'
    type: 'truefalse'
    definition: @aql ecommerce_orders.status == 'delivered';;
  }

  // Named aggregation over a sibling field, not a source column.
  measure last_created_at {
    label: 'Last Created At'
    type: 'datetime'
    definition: @sql {{ created_at }};;
    aggregation_type: 'max'
  }

  measure count_orders {
    label: 'Count Orders'
    type: 'number'
    definition: @sql {{ #SOURCE.id }};;
    aggregation_type: 'count'
  }

  // AQL: the filter resolves through the dataset relationship graph.
  measure delivered_orders {
    label: 'Delivered Orders'
    type: 'number'
    hidden: true
    definition: @aql count(ecommerce_orders.id) | where(ecommerce_orders.delivered);;
  }

  owner: 'dev@ossie.apache.org'
}
