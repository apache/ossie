Model calendar {
  type: 'table'
  label: 'Calendar'
  description: 'A date spine. Lives in the reporting module, so its compiled name is reporting::calendar.'
  data_source_name: 'bigquery_demo'
  table_name: '`ecommerce`.`calendar`'

  dimension date {
    label: 'Date'
    type: 'date'
    definition: @sql {{ #SOURCE.date }};;
    primary_key: true
  }

  dimension year {
    label: 'Year'
    type: 'number'
    definition: @sql {{ #SOURCE.year }};;
  }

  dimension is_weekend {
    label: 'Is Weekend'
    type: 'truefalse'
    definition: @sql {{ #SOURCE.is_weekend }};;
  }

  owner: 'dev@ossie.apache.org'
}
