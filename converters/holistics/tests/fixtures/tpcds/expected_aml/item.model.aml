Model item {
  type: 'table'
  label: 'Item'
  description: 'Item/Product dimension with product attributes'
  data_source_name: 'tpcds_warehouse'
  table_name: 'tpcds.public.item'

  dimension i_item_sk {
    label: 'I Item Sk'
    type: 'number'
    description: 'Surrogate key for item'
    definition: @sql {{ #SOURCE.i_item_sk }};;
    primary_key: true
  }

  dimension i_item_id {
    label: 'I Item Id'
    type: 'text'
    description: 'Business key for item'
    definition: @sql {{ #SOURCE.i_item_id }};;
  }

  dimension i_item_desc {
    label: 'I Item Desc'
    type: 'text'
    description: 'Item description'
    definition: @sql {{ #SOURCE.i_item_desc }};;
  }

  dimension i_brand {
    label: 'I Brand'
    type: 'text'
    description: 'Brand name'
    definition: @sql {{ #SOURCE.i_brand }};;
  }

  dimension i_category {
    label: 'I Category'
    type: 'text'
    description: 'Item category'
    definition: @sql {{ #SOURCE.i_category }};;
  }

  dimension i_current_price {
    label: 'I Current Price'
    type: 'number'
    description: 'Current price of the item'
    definition: @sql {{ #SOURCE.i_current_price }};;
  }
}
