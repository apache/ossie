Model store_sales {
  type: 'table'
  label: 'Store Sales'
  description: 'Fact table containing all store sales transactions'
  data_source_name: 'tpcds_warehouse'
  table_name: 'tpcds.public.store_sales'

  dimension ss_sold_date_sk {
    label: 'Ss Sold Date Sk'
    type: 'number'
    description: 'Foreign key to date dimension'
    definition: @sql {{ #SOURCE.ss_sold_date_sk }};;
  }

  dimension ss_item_sk {
    label: 'Ss Item Sk'
    type: 'number'
    description: 'Foreign key to item dimension'
    definition: @sql {{ #SOURCE.ss_item_sk }};;
    primary_key: true
  }

  dimension ss_customer_sk {
    label: 'Ss Customer Sk'
    type: 'number'
    description: 'Foreign key to customer dimension'
    definition: @sql {{ #SOURCE.ss_customer_sk }};;
  }

  dimension ss_store_sk {
    label: 'Ss Store Sk'
    type: 'number'
    description: 'Foreign key to store dimension'
    definition: @sql {{ #SOURCE.ss_store_sk }};;
  }

  dimension ss_quantity {
    label: 'Ss Quantity'
    type: 'number'
    description: 'Quantity of items sold'
    definition: @sql {{ #SOURCE.ss_quantity }};;
  }

  dimension ss_sales_price {
    label: 'Ss Sales Price'
    type: 'number'
    description: 'Sales price per unit'
    definition: @sql {{ #SOURCE.ss_sales_price }};;
  }

  dimension ss_ext_sales_price {
    label: 'Ss Ext Sales Price'
    type: 'number'
    description: 'Extended sales price (quantity * price)'
    definition: @sql {{ #SOURCE.ss_ext_sales_price }};;
  }

  dimension ss_net_profit {
    label: 'Ss Net Profit'
    type: 'number'
    description: 'Net profit from the sale'
    definition: @sql {{ #SOURCE.ss_net_profit }};;
  }

  measure total_sales {
    label: 'Total Sales'
    type: 'number'
    description: 'Total sales revenue across all transactions'
    definition: @sql SUM({{ ss_ext_sales_price }});;
    aggregation_type: 'custom'
  }

  measure total_profit {
    label: 'Total Profit'
    type: 'number'
    description: 'Total net profit from store sales'
    definition: @sql SUM({{ ss_net_profit }});;
    aggregation_type: 'custom'
  }

  measure sales_by_brand {
    label: 'Sales By Brand'
    type: 'number'
    description: 'Total sales by brand (requires grouping by item.i_brand)'
    definition: @sql SUM({{ ss_ext_sales_price }});;
    aggregation_type: 'custom'
  }
}
