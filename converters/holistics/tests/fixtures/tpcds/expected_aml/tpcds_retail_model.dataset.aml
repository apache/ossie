Dataset tpcds_retail_model {
  label: 'Tpcds Retail Model'
  description: 'TPC-DS retail semantic model for sales and customer analytics'
  data_source_name: 'tpcds_warehouse'

  models: [
    store_sales,
    date_dim,
    customer,
    item,
    store,
  ]

  relationships: [
    relationship(store_sales.ss_sold_date_sk > date_dim.d_date_sk, true),
    relationship(store_sales.ss_customer_sk > customer.c_customer_sk, true),
    relationship(store_sales.ss_item_sk > item.i_item_sk, true),
    relationship(store_sales.ss_store_sk > store.s_store_sk, true),
  ]

  metric customer_lifetime_value {
    label: 'Customer Lifetime Value'
    type: 'number'
    description: 'Average lifetime sales value per customer'
    definition: @aql sum(store_sales.ss_ext_sales_price) / count_distinct(customer.c_customer_sk);;
  }

  metric store_productivity {
    label: 'Store Productivity'
    type: 'number'
    description: 'Sales per employee across stores'
    definition: @aql sum(store_sales.ss_ext_sales_price) / nullif(sum(store.s_number_employees), 0);;
  }
}
