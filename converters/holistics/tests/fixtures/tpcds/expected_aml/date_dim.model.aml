Model date_dim {
  type: 'table'
  label: 'Date Dim'
  description: 'Date dimension with calendar attributes'
  data_source_name: 'tpcds_warehouse'
  table_name: 'tpcds.public.date_dim'

  dimension d_date_sk {
    label: 'D Date Sk'
    type: 'number'
    description: 'Surrogate key for date'
    definition: @sql {{ #SOURCE.d_date_sk }};;
    primary_key: true
  }

  dimension d_date {
    label: 'D Date'
    type: 'date'
    description: 'Actual date value'
    definition: @sql {{ #SOURCE.d_date }};;
  }

  dimension d_year {
    label: 'D Year'
    type: 'number'
    description: 'Year'
    definition: @sql {{ #SOURCE.d_year }};;
  }

  dimension d_quarter_name {
    label: 'D Quarter Name'
    type: 'text'
    description: 'Quarter name (e.g., 2024Q1)'
    definition: @sql {{ #SOURCE.d_quarter_name }};;
  }

  dimension d_moy {
    label: 'D Moy'
    type: 'text'
    description: 'Month of year (1-12)'
    definition: @sql {{ #SOURCE.d_moy }};;
  }
}
