Model store {
  type: 'table'
  label: 'Store'
  description: 'Store dimension with location and store attributes'
  data_source_name: 'tpcds_warehouse'
  table_name: 'tpcds.public.store'

  dimension s_store_sk {
    label: 'S Store Sk'
    type: 'number'
    description: 'Surrogate key for store'
    definition: @sql {{ #SOURCE.s_store_sk }};;
    primary_key: true
  }

  dimension s_store_id {
    label: 'S Store Id'
    type: 'text'
    description: 'Business key for store'
    definition: @sql {{ #SOURCE.s_store_id }};;
  }

  dimension s_store_name {
    label: 'S Store Name'
    type: 'text'
    description: 'Store name'
    definition: @sql {{ #SOURCE.s_store_name }};;
  }

  dimension s_city {
    label: 'S City'
    type: 'text'
    description: 'City where store is located'
    definition: @sql {{ #SOURCE.s_city }};;
  }

  dimension s_state {
    label: 'S State'
    type: 'text'
    description: 'State where store is located'
    definition: @sql {{ #SOURCE.s_state }};;
  }

  dimension s_number_employees {
    label: 'S Number Employees'
    type: 'number'
    description: 'Number of employees at the store'
    definition: @sql {{ #SOURCE.s_number_employees }};;
  }
}
