Model customer {
  type: 'table'
  label: 'Customer'
  description: 'Customer dimension with demographic information'
  data_source_name: 'tpcds_warehouse'
  table_name: 'tpcds.public.customer'

  dimension c_customer_sk {
    label: 'C Customer Sk'
    type: 'number'
    description: 'Surrogate key for customer'
    definition: @sql {{ #SOURCE.c_customer_sk }};;
    primary_key: true
  }

  dimension c_customer_id {
    label: 'C Customer Id'
    type: 'text'
    description: 'Business key for customer'
    definition: @sql {{ #SOURCE.c_customer_id }};;
  }

  dimension c_first_name {
    label: 'C First Name'
    type: 'text'
    description: 'Customer first name'
    definition: @sql {{ #SOURCE.c_first_name }};;
  }

  dimension c_last_name {
    label: 'C Last Name'
    type: 'text'
    description: 'Customer last name'
    definition: @sql {{ #SOURCE.c_last_name }};;
  }

  dimension customer_full_name {
    label: 'Customer Full Name'
    type: 'text'
    description: 'Customer full name (computed field)'
    definition: @sql {{ #SOURCE.c_first_name }} || ' ' || {{ #SOURCE.c_last_name }};;
  }

  dimension c_email_address {
    label: 'C Email Address'
    type: 'text'
    description: 'Customer email address'
    definition: @sql {{ #SOURCE.c_email_address }};;
  }
}
