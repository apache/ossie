{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:apache:ossie:execute-query:capture:0.4-draft",
  "$comment": "Licensed to the Apache Software Foundation (ASF) under one or more contributor license agreements. See NOTICE for copyright ownership. Licensed under the Apache License, Version 2.0, http://www.apache.org/licenses/LICENSE-2.0 . Distributed on an AS IS BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND. Capture format for offline endpoint contract checks; not an MCP RPC.",
  "type": "object", "additionalProperties": false,
  "required": ["protocol_version", "tool", "cases"],
  "properties": {
    "$comment": {"type": "string"},
    "protocol_version": {"const": "2026-07-28"},
    "tool": {
      "type": "object", "required": ["name", "inputSchema"],
      "properties": {
        "name": {"const": "execute_query"},
        "title": {"type": "string"},
        "description": {"type": "string"},
        "_meta": {"type": "object"},
        "inputSchema": {"type": "object"},
        "outputSchema": {"type": "object"},
        "annotations": {
          "type": "object",
          "properties": {
            "title": {"type": "string"},
            "readOnlyHint": {"type": "boolean"},
            "destructiveHint": {"type": "boolean"},
            "idempotentHint": {"type": "boolean"},
            "openWorldHint": {"type": "boolean"}
          }
        }
      }
    },
    "cases": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["arguments", "result"],
        "properties": {
          "name": {"type": "string"},
          "arguments": {"type": "object"},
          "result": {"$ref": "urn:apache:ossie:execute-query:call-result:0.4-draft"}
        }
      }
    }
  }
}
